// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Alumni {
  id               String    @id @default(uuid())
  nia              String    @unique
  namaLengkap      String
  noWhatsapp       String    @unique
  alamat           String?
  angkatanMasuk    Int?
  angkatanLulus    Int?
  dataVerifiedAt   DateTime?
  source           String    @default("MIGRATED_HISTORICAL")
  pinHash          String?
  pinFailedAttempt Int       @default(0)
  pinLockedUntil   DateTime?
  fotoUrl          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  partisipasi PartisipasiHaul[]
  doorprizeWinners DoorprizeWinner[]
  doorprizeEntries DoorprizeEntry[]
}

model PartisipasiHaul {
  id              String    @id @default(uuid())
  alumniId        String
  alumni          Alumni    @relation(fields: [alumniId], references: [id])
  tahunAcara      Int
  tahlilAkbar     String?
  haul            String?
  menginap        String?
  membawaPasangan Boolean   @default(false)
  jumlahAnak      Int       @default(0)
  checkedInAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([alumniId, tahunAcara])
}

model DoorprizeWinner {
  id         String   @id @default(uuid())
  alumniId   String
  alumni     Alumni   @relation(fields: [alumniId], references: [id])
  tahunAcara Int
  namaHadiah String?
  createdAt  DateTime @default(now())

  @@unique([alumniId, tahunAcara])
}

// Sesi presensi khusus sebelum undian doorprize — alumni scan QR sesi ini
// sendiri lewat HP masing-masing untuk membuktikan benar-benar hadir di
// lokasi, dibatasi waktu (countdown). Terpisah dari PartisipasiHaul.checkedInAt
// (check-in umum) karena yang itu terbukti bisa ditandai manual tanpa
// verifikasi fisik penuh saat acara padat.
model DoorprizeSession {
  id         String    @id @default(uuid())
  tahunAcara Int
  token      String    @unique
  expiresAt  DateTime
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  entries DoorprizeEntry[]
}

model DoorprizeEntry {
  id         String           @id @default(uuid())
  sessionId  String
  session    DoorprizeSession @relation(fields: [sessionId], references: [id])
  alumniId   String
  alumni     Alumni           @relation(fields: [alumniId], references: [id])
  createdAt  DateTime         @default(now())

  @@unique([sessionId, alumniId])
}
